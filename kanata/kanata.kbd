;; Conservative macOS configuration.
;;
;; Ordinary keys are passed through unchanged. Caps Lock is the only dual-role
;; key: tap it for Escape, or hold it with another mapped key for Left Control.

(defcfg
  process-unmapped-keys no
)

(defalias
  cap (tap-hold-press 200 200 esc lctl)
)

(defsrc
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l ; ' ret
  lsft z x c v b n m , . / rsft
  lctl lalt lmet spc rmet ralt rctl
)

(deflayer def
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] \
  @cap a s d f g h j k l ; ' ret
  lsft z x c v b n m , . / rsft
  lctl lalt lmet spc rmet ralt rctl
)
